class VariantPage extends StatelessWidget {
  final String model;

  const VariantPage({
    super.key,
    required this.model,
  });

  List<String> getStorage() {
    if (model.contains('iPhone 18') ||
        model.contains('iPhone 17') ||
        model.contains('iPhone 16') ||
        model.contains('iPhone 15') ||
        model.contains('iPhone 14')) {
      return [
        '128 GB',
        '256 GB',
        '512 GB',
        '1 TB',
      ];
    }

    if (model.contains('Pro Max')) {
      return [
        '256 GB',
        '512 GB',
        '1 TB',
      ];
    }

    if (model.contains('Pro')) {
      return [
        '128 GB',
        '256 GB',
        '512 GB',
        '1 TB',
      ];
    }

    if (model.contains('iPhone 13') ||
        model.contains('iPhone 12')) {
      return [
        '64 GB',
        '128 GB',
        '256 GB',
      ];
    }

    if (model.contains('iPhone 11')) {
      return [
        '64 GB',
        '128 GB',
        '256 GB',
      ];
    }

    return [
      '64 GB',
      '128 GB',
      '256 GB',
      '512 GB',
    ];
  }

  @override
  Widget build(BuildContext context) {
    final storageList = getStorage();

    return Scaffold(
      appBar: AppBar(
        title: const Text('Select Storage'),
      ),
      body: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
