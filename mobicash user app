  // ==========================================================
  // PRICE CALCULATION
  // ==========================================================

  void calculatePrice() {
    double price = device.basePrice;

    // --------------------------------------------------------
    // WORKING CONDITION
    // --------------------------------------------------------

    if (device.working == 'Partially Working') {
      price *= 0.70;
    } else if (device.working == 'Not Working') {
      price *= 0.35;
    }

    if (device.power == 'Does Not Turn On') {
      price *= 0.40;
    }

    // --------------------------------------------------------
    // SCREEN
    // --------------------------------------------------------

    switch (device.screen) {
      case 'Minor Scratches':
        price *= 0.95;
        break;

      case 'Major Scratches':
        price *= 0.88;
        break;

      case 'Cracked':
        price *= 0.55;
        break;

      case 'Display Issue':
        price *= 0.45;
        break;
    }

    // --------------------------------------------------------
    // BODY
    // --------------------------------------------------------

    switch (device.body) {
      case 'Minor Scratches':
        price *= 0.97;
        break;

      case 'Heavy Damage':
        price *= 0.88;
        break;

      case 'Back Broken':
        price *= 0.70;
        break;
    }

    // --------------------------------------------------------
    // BATTERY
    // --------------------------------------------------------

    switch (device.battery) {
      case 'Average':
        price *= 0.95;
        break;

      case 'Poor':
        price *= 0.82;
        break;
    }

    // --------------------------------------------------------
    // CAMERA
    // --------------------------------------------------------

    if (device.camera == 'Rear Camera Issue' ||
        device.camera == 'Front Camera Issue') {
      price *= 0.88;
    } else if (device.camera == 'Both Camera Issue') {
      price *= 0.72;
    }

    // --------------------------------------------------------
    // SPEAKER / MIC
    // --------------------------------------------------------

    if (device.speakerMic == 'Speaker Issue' ||
        device.speakerMic == 'Microphone Issue') {
      price *= 0.92;
    } else if (device.speakerMic == 'Both Issue') {
      price *= 0.82;
    }

    // --------------------------------------------------------
    // CHARGING
    // --------------------------------------------------------

    if (device.charging == 'Slow / Intermittent') {
      price *= 0.92;
    } else if (device.charging == 'Not Charging') {
      price *= 0.70;
    }

    // --------------------------------------------------------
    // CONNECTIVITY
    // --------------------------------------------------------

    if (device.connectivity == 'Issue') {
      price *= 0.88;
    }

    // --------------------------------------------------------
    // BIOMETRIC
    // --------------------------------------------------------

    if (device.biometric == 'Not Working') {
      price *= 0.94;
    }

    // --------------------------------------------------------
    // NETWORK
    // --------------------------------------------------------

    if (device.simNetwork == 'Network Issue') {
      price *= 0.65;
    }

    // --------------------------------------------------------
    // BILL
    // --------------------------------------------------------

    if (device.bill == 'No') {
      price *= 0.97;
    }

    // --------------------------------------------------------
    // WARRANTY
    // --------------------------------------------------------

    if (device.warranty == 'Yes') {
      price *= 1.03;
    }

    // --------------------------------------------------------
    // ACCESSORIES
    // --------------------------------------------------------

    if (device.accessories == 'Full Box + Charger') {
      price *= 1.03;
    } else if (device.accessories == 'Box Only') {
      price *= 1.01;
    } else if (device.accessories == 'No Box / Accessories') {
      price *= 0.98;
    }

    // --------------------------------------------------------
    // NEW MOBILE AGE CALCULATION
    // --------------------------------------------------------

    switch (device.age) {
      case 'Below 3 Months':
        // Almost new
        price *= 0.98;
        break;

      case '3–6 Months':
        price *= 0.95;
        break;

      case '6–11 Months':
        price *= 0.92;
        break;

      case '1 Year+':
        price *= 0.82;
        break;
    }

    // --------------------------------------------------------
    // REPAIR
    // --------------------------------------------------------

    if (device.repair == 'Minor Repair') {
      price *= 0.94;
    } else if (device.repair == 'Major Repair') {
      price *= 0.75;
    }

    // --------------------------------------------------------
    // WATER DAMAGE
    // --------------------------------------------------------

    if (device.waterDamage == 'Yes') {
      price *= 0.45;
    }

    // --------------------------------------------------------
    // FINAL PRICE
    // --------------------------------------------------------

    device.finalPrice = price.clamp(
      500,
      device.basePrice,
    );
  }
}

