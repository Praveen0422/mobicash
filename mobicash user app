class ConfirmationPage extends StatelessWidget {
  const ConfirmationPage({super.key});

  String getOrderId() {
    return 'MC${DateTime.now().millisecondsSinceEpoch.toString().substring(6)}';
  }

  Future<void> saveOrder(String orderId) async {
    final user = FirebaseAuth.instance.currentUser;

    if (user == null) {
      throw Exception('User not logged in');
    }

    await FirebaseFirestore.instance
        .collection('orders')
        .doc(orderId)
        .set({
      'orderId': orderId,

      // USER
      'userId': user.uid,
      'phoneNumber': user.phoneNumber,

      // DEVICE
      'deviceType': device.type,
      'brand': device.brand,
      'model': device.model,
      'storage': device.storage,

      // PRICE
      'basePrice': device.basePrice,
      'finalPrice': device.finalPrice,

      // PICKUP
      'pickupMethod': device.pickupMethod,
      'pickupDate': device.pickupDate,
      'pickupTime': device.pickupTime,

      // ADDRESS
      'address': device.address,
      'city': device.city,
      'pincode': device.pincode,

      // PAYMENT
      'paymentMethod': device.paymentMethod,

      // STATUS
'status': 'New',

      // CREATED TIME
      'createdAt': FieldValue.serverTimestamp(),
    });
  }

  @override
  Widget build(BuildContext context) {
    final orderId = getOrderId();

    return Scaffold(
      body: SafeArea(
        child: Center(
          child: SingleChildScrollView(
            padding: const EdgeInsets.all(25),
            child: Column(
              children: [
                // SUCCESS ICON
                Container(
                  width: 90,
                  height: 90,
                  decoration: BoxDecoration(
                    color: Colors.green.shade100,
                    shape: BoxShape.circle,
                  ),
                  child: const Icon(
                    Icons.check,
                    size: 55,
                    color: Colors.green,
                  ),
                ),

                const SizedBox(height: 25),

                const Text(
                  'Sale Request Confirmed!',
                  textAlign: TextAlign.center,
                  style: TextStyle(
                    fontSize: 26,
                    fontWeight: FontWeight.bold,
                  ),
                ),

                const SizedBox(height: 10),

                Text(
                  'Your ${device.brand} ${device.model} sale request has been created.',
                  textAlign: TextAlign.center,
                  style: TextStyle(
                    color: Colors.grey.shade600,
                    fontSize: 15,
                  ),
                ),

                const SizedBox(height: 25),

                // ORDER DETAILS
                Container(
                  width: double.infinity,
                  padding: const EdgeInsets.all(20),
                  decoration: BoxDecoration(
                    color: Colors.white,
                    borderRadius: BorderRadius.circular(18),
                  ),
                  child: Column(
                    children: [
                      Text(
                        'Order ID',
                        style: TextStyle(
                          color: Colors.grey.shade600,
                        ),
                      ),

                      const SizedBox(height: 7),

                      Text(
                        orderId,
                        style: const TextStyle(
                          fontSize: 21,
                          fontWeight: FontWeight.bold,
                        ),
                      ),

                      const Divider(height: 30),

                      Text(
                        'Estimated Value',
                        style: TextStyle(
                          color: Colors.grey.shade600,
                        ),
                      ),

                      const SizedBox(height: 5),

                      Text(
                        '₹${device.finalPrice.round()}',
                        style: TextStyle(
                          fontSize: 30,
                          fontWeight: FontWeight.bold,
                          color: Colors.green.shade700,
                        ),
                      ),
                    ],
                  ),
                ),

                const SizedBox(height: 20),

                // PICKUP DETAILS
                Text(
                  '${device.pickupMethod}\n'
                  '${device.pickupDate} • ${device.pickupTime}',
                  textAlign: TextAlign.center,
                  style: const TextStyle(
                    fontWeight: FontWeight.w600,
                  ),
                ),

                const SizedBox(height: 30),

                // SAVE ORDER BUTTON
                SizedBox(
                  width: double.infinity,
                  height: 52,
                  child: ElevatedButton(
                    onPressed: () async {
                      try {
                        await saveOrder(orderId);

                        if (!context.mounted) return;

                        ScaffoldMessenger.of(context).showSnackBar(
                          const SnackBar(
                            content: Text(
                              'Order saved successfully!',
                            ),
                          ),
                        );

                        Navigator.pushAndRemoveUntil(
                          context,
                          MaterialPageRoute(
                            builder: (_) => const HomePage(),
                          ),
                          (route) => false,
                        );
                      } catch (e) {
                        if (!context.mounted) return;

                        ScaffoldMessenger.of(context).showSnackBar(
                          SnackBar(
                            content: Text(
                              'Failed to save order: $e',
                            ),
                          ),
                        );
                      }
                    },
                    child: const Text(
                      'Back to Home',
                      style: TextStyle(
                        fontSize: 16,
                      ),
                    ),
                  ),
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }
}

